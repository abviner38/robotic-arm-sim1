<?xml version="1.0"?>
<robot name="articulated_4dof_gripper_arm">

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.11"/>
      </geometry>
      <material name="slate">
        <color rgba="0.35 0.38 0.42 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.11"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.012" ixy="0.0" ixz="0.0" iyy="0.012" iyz="0.0" izz="0.018"/>
    </inertial>
  </link>

  <!-- Link 1: Turret / Base Rotation -->
  <link name="link_1_turret">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.06"/>
      </geometry>
      <material name="blue">
        <color rgba="0.18 0.45 0.85 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <!-- Joint 1: Base Yaw (Z) -->
  <joint name="joint_1_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="link_1_turret"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="15.0" velocity="2.5"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>

  <!-- Link 2: Upper Arm (L1 = 0.28 m along +Z in local frame) -->
  <link name="link_2_upper_arm">
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.055 0.28"/>
      </geometry>
      <material name="teal">
        <color rgba="0.10 0.68 0.62 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.055 0.28"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <mass value="0.65"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.0045" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 2: Shoulder Pitch (Y) -->
  <joint name="joint_2_shoulder" type="revolute">
    <parent link="link_1_turret"/>
    <child link="link_2_upper_arm"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="15.0" velocity="2.5"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Link 3: Forearm (L2 = 0.24 m along +Z in local frame) -->
  <link name="link_3_forearm">
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.045 0.24"/>
      </geometry>
      <material name="orange">
        <color rgba="0.92 0.52 0.12 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.045 0.24"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.0025" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0007"/>
    </inertial>
  </link>

  <!-- Joint 3: Elbow Pitch (Y) -->
  <joint name="joint_3_elbow" type="revolute">
    <parent link="link_2_upper_arm"/>
    <child link="link_3_forearm"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="12.0" velocity="2.5"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>

  <!-- Link 4: Wrist / Gripper Mount -->
  <link name="link_4_wrist">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.06 0.08"/>
      </geometry>
      <material name="crimson">
        <color rgba="0.82 0.22 0.28 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.06 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0" iyy="0.0008" iyz="0.0" izz="0.0008"/>
    </inertial>
  </link>

  <!-- Joint 4: Wrist Pitch (Y) -->
  <joint name="joint_4_wrist" type="revolute">
    <parent link="link_3_forearm"/>
    <child link="link_4_wrist"/>
    <origin xyz="0 0 0.24" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="8.0" velocity="3.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Left Gripper Finger -->
  <link name="left_finger">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.025 0.08"/>
      </geometry>
      <material name="light_gray">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.025 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Left Finger Prismatic Joint (slides along X) -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="link_4_wrist"/>
    <child link="left_finger"/>
    <origin xyz="-0.025 0 0.08" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.025" effort="5.0" velocity="0.2"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Right Gripper Finger -->
  <link name="right_finger">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.025 0.08"/>
      </geometry>
      <material name="light_gray">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.025 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Right Finger Prismatic Joint (slides along -X) -->
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="link_4_wrist"/>
    <child link="right_finger"/>
    <origin xyz="0.025 0 0.08" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.025" effort="5.0" velocity="0.2"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

</robot>
